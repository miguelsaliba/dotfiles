# noctalia dark is just a symlink due to a bug with ghostty not reporting the correct theme without separate theme names
# https://github.com/ghostty-org/ghostty/pull/13605
theme = light:noctalia,dark:noctalia-dark

background-opacity = 0.8

custom-shader = shaders/cursor_warp.glsl

